from manim import *

class OZ_StyleAnimation(Scene):
    def construct(self):
        # Fond blanc futuriste
        self.camera.background_color = WHITE
        
        # Ovale central (où placer le visage)
        oval = Ellipse(width=3, height=4, color=BLUE).set_stroke(width=6)
        self.play(Create(oval), run_time=1.5)

        # Cercle extérieur animé (halo lumineux)
        halo = Circle(radius=2.5, color=GREEN).set_stroke(width=3, opacity=0.7)
        self.play(Create(halo), run_time=1)
        self.play(halo.animate.scale(1.2).set_opacity(0), run_time=2)

        # Lignes numériques dynamiques
        lines = VGroup(
            *[Line(UP * 3, DOWN * 3, color=BLUE).shift(RIGHT * i) for i in range(-5, 6, 2)]
        )
        self.play(*[line.animate.shift(UP * 0.5) for line in lines], run_time=1.5)

        # Effet de scintillement
        for _ in range(3):
            self.play(oval.animate.set_color(YELLOW), run_time=0.3)
            self.play(oval.animate.set_color(BLUE), run_time=0.3)

        # Animation de sortie
        self.play(FadeOut(oval, halo, lines), run_time=1)

        # Durée totale = 5s
